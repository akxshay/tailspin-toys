---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg" data-testid="filter-controls">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end">
        <fieldset class="flex-1">
          <legend class="mb-3 text-sm font-medium text-slate-200">Filter by category</legend>
          <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
              <label
                class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors duration-200 hover:border-blue-500/60 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                data-testid={`category-filter-label-${category.id}`}
              >
                <input
                  type="checkbox"
                  value={category.id}
                  class="h-4 w-4 accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-filter-type="category"
                  data-testid={`category-filter-${category.id}`}
                  aria-label={`Filter games by ${category.name}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="min-w-[220px]">
          <label class="block text-sm font-medium text-slate-200" for="publisher-filter">Filter by publisher</label>
          <select
            id="publisher-filter"
            class="mt-2 w-full rounded-lg border border-slate-600 bg-slate-900/70 px-3 py-2 text-slate-100 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
            data-filter-type="publisher"
            aria-label="Filter games by publisher"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <button
          type="button"
          class="rounded-lg border border-slate-600 bg-slate-900/70 px-4 py-2 text-sm font-medium text-slate-100 transition-colors duration-200 hover:border-blue-500/60 hover:text-blue-300 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>
    </div>

    <div>
      <div class="mb-4 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-300" data-testid="filter-summary" aria-live="polite" hidden></p>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div id="games-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div data-testid="games-empty-state" class="hidden">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-type="category"]'));
    const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="games-empty-state"]');
    const filterSummary = document.querySelector<HTMLElement>('[data-testid="filter-summary"]');

    const syncUrlState = () => {
      const params = new URLSearchParams(window.location.search);
      params.delete('category');
      params.delete('publisher');

      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => input.value);
      const publisherValue = publisherSelect && publisherSelect.value ? publisherSelect.value : '';

      selectedCategories.forEach((categoryId) => params.append('category', categoryId));
      if (publisherValue) {
        params.set('publisher', publisherValue);
      }

      const nextUrl = `${window.location.pathname}${params.size > 0 ? `?${params.toString()}` : ''}`;
      window.history.replaceState({}, '', nextUrl);
    };

    const applyFilters = () => {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => Number(input.value));
      const selectedPublisher = publisherSelect && publisherSelect.value ? Number(publisherSelect.value) : null;

      let visibleCount = 0;
      gameCards.forEach((card) => {
        const categoryIds = (card.dataset.gameCategoryIds ?? '')
          .split(',')
          .filter((value) => value.length > 0)
          .map(Number);
        const publisherId = card.dataset.gamePublisherId ? Number(card.dataset.gamePublisherId) : null;
        const matchesCategory = selectedCategories.length === 0 || selectedCategories.some((categoryId) => categoryIds.includes(categoryId));
        const matchesPublisher = selectedPublisher === null || publisherId === selectedPublisher;
        const shouldShow = matchesCategory && matchesPublisher;

        card.hidden = !shouldShow;
        if (shouldShow) {
          visibleCount += 1;
        }
      });

      if (gamesGrid) {
        gamesGrid.hidden = visibleCount === 0;
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount !== 0);
      }

      if (filterSummary) {
        filterSummary.hidden = false;
        filterSummary.textContent = visibleCount === 0
          ? 'No games match the selected filters.'
          : `${visibleCount} game${visibleCount === 1 ? '' : 's'} match your current filters.`;
      }

      syncUrlState();
    };

    const initializeFilters = () => {
      const params = new URLSearchParams(window.location.search);
      const selectedCategories = params.getAll('category');
      const selectedPublisher = params.get('publisher');

      categoryInputs.forEach((input) => {
        input.checked = selectedCategories.includes(input.value);
      });

      if (publisherSelect) {
        publisherSelect.value = selectedPublisher ?? '';
      }

      applyFilters();
    };

    categoryInputs.forEach((input) => input.addEventListener('change', applyFilters));
    if (publisherSelect) {
      publisherSelect.addEventListener('change', applyFilters);
    }

    if (clearButton) {
      clearButton.addEventListener('click', () => {
        categoryInputs.forEach((input) => {
          input.checked = false;
        });

        if (publisherSelect) {
          publisherSelect.value = '';
        }

        applyFilters();
      });
    }

    initializeFilters();
  </script>
</Layout>
